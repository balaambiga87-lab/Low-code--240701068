/*
 * Author       : deepika.ss.2024.cse_rajal90
 * Generated on : 29-Oct-2026 22:24:44
 * Version      : 1.0
 */
 application "CampusHire"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Company
		{
			success message = "Company Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Company_Name
			(
    			type = text
				displayname = "Company Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Email
			(
    			type = email
				displayname = "Company Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			HR_Contact
			(
    			type = phonenumber
				displayname = "HR Contact"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Company_Location
			(
    			type = address
				displayname = "Company Location"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Industry
			(
				type = picklist
				maxchar = 100
				values = {"Finance","IT","Healthcare","Automobile","Consulting","E-Commerce","Education","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Website
			(
    			type = url
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Interview
		{
			success message = "Interview Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student
			(
				type = picklist
				maxchar = 100
				values = {"Deva","Bala","Varun"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company
			(
				type = picklist
				maxchar = 100
				values = {"TCS","Wipro","Infosys"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Job_Role
			(
    			type = text
				displayname = "Job Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Date
			(
    			type = date
				displayname = "Interview Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Mode
			(
				type = picklist
				displayname = "Interview Mode"
				maxchar = 100
				values = {"Online","Offline","Choice 3"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Round
			(
				type = picklist
				displayname = "Interview Round"
				maxchar = 100
				values = {"Aptitude Test","Technical Round","HR Round","Final Round"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Status
			(
				type = picklist
				displayname = "Interview Status"
				maxchar = 100
				values = {"Scheduled","Completed","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Result
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Selected","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Application
		{
			displayname = "Job Application"
			success message = "Job Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Student
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Student1
			(
				type = picklist
				displayname = "Student"
				maxchar = 100
				values = {"Deva","Bala","Varun"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Placement_Drive
			(
				type = picklist
				displayname = "Placement Drive"
				maxchar = 100
				values = {"Java Developer – TCS","Web Developer – Infosys","Data Analyst – Wipro"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Status
			(
				type = picklist
				displayname = "Application Status"
				maxchar = 100
				values = {"Applied","Shortliste","Selected","Rejected","Interview Scheduled","Not Selected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Placement_Drive
		{
			displayname = "Placement Drive"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Job_Role
			(
    			type = text
				displayname = "Job Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company
			(
				type = list	
				values  = Company.ID
    			displayformat = [Company_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Job_Location
			(
    			type = text
				displayname = "Job Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Minimum_CGPA
			(
				type = number
				displayname = "Minimum CGPA"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Required_Skills
			(
				type = list	
				displayname = "Required Skills"
				values = {"JAVA","C","C++","PYTHON","HTML","CSS","JAVASCRIPT","SQL","REACT","PROBLEM SOLVING","COMMUNICATION"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Salary_Package_LPA
			(
				type = number
				displayname = "Salary Package (LPA)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Application_Deadline
			(
    			type = date
				displayname = "Application Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Drive_Date
			(
    			type = date
				displayname = "Drive Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Drive_Status
			(
				type = picklist
				displayname = "Drive Status"
				maxchar = 100
				values = {"Upcoming","Coming","Close","Closed","completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Student_Registration
		{
			displayname = "Student Registration"
			success message = "Student Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Student_Name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Register_Number
			(
				type = number
				displayname = "Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Department
			(
				type = picklist
				displayname = "Department "
				maxchar = 100
				values = {"CSE","ECE","EEE","IT","MECH","CIVIL","AIDS","AIML"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Year_field
			(
				type = picklist
				displayname = "Year"
				maxchar = 100
				values = {"2nd Year","3rd Year","4th Year"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CGPA
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Skills
			(
				type = list	
				values = {"JAVA","CSS","C++","HTML","PYTHON","C","JAVASCRIPT","SQL","REACT","COMMUNICATION"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certification
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resume
			(
    			type = upload file
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Placement_status
			(
				type = picklist
				displayname = "Placement status"
				maxchar = 100
				values = {"Not Placed","Placed","Not Eligible"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Job_Role
			(
				type = picklist
				displayname = "Preferred Job Role"
				maxchar = 100
				values = {"Software Developer","Web Developer","Data Analyst","Software Tester","UI/UX Designer","Cloud Engineer","Cybersecurity Analyst","AI/ML Engineer","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Location
			(
				type = picklist
				displayname = "Preferred Location"
				maxchar = 100
				values = {"Chennai","Bangalore","Hyderabad","Pune","Mumbai","Coimbatore","Delhi","Any Location"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internship_Experience
			(
    			type = textarea
				displayname = "Internship Experience"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Projects
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_of_Backlogs
			(
				type = number
				displayname = "Number of Backlogs"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Student_Registrations
		{
			displayName = "All Student Registrations"
			show all rows from Student_Registration    
			(
				Student_Name  as "Student Name"
				Register_Number as "Register Number"
				Email
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Department as "Department "
				Year_field as "Year"
				Skills
				Resume
				Placement_status as "Placement status"
				CGPA
				Certification
				Preferred_Job_Role as "Preferred Job Role"
				Preferred_Location as "Preferred Location"
				Internship_Experience as "Internship Experience"
				Projects
				Number_of_Backlogs as "Number of Backlogs"
			)
		}
		default list All_Companies
		{
			displayName = "All Companies"
			show all rows from Company    
			(
				Company_Name as "Company Name"
				Company_Email as "Company Email"
				HR_Contact as "HR Contact"
				(
					displayformat = plainnumber 
				)
				Company_Location  as "Company Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Industry
				Website
			)
		}
		default list Placement_Drive_Report
		{
			displayName = "Placement Drive Report"
			show all rows from Placement_Drive    
			(
				Job_Role as "Job Role"
				Company
				Job_Location as "Job Location"
				Minimum_CGPA as "Minimum CGPA"
				Required_Skills as "Required Skills"
				Salary_Package_LPA as "Salary Package (LPA)"
				Application_Deadline as "Application Deadline"
				Drive_Date as "Drive Date"
				Drive_Status as "Drive Status"
			)
			sort by
			(
				Application_Deadline ascending
			)
		}
		default list All_Job_Applications
		{
			displayName = "All Job Applications"
			show all rows from Job_Application    
			(
				Student 
				Student1 as "Student"
				Placement_Drive as "Placement Drive"
				Application_Date as "Application Date"
				Application_Status as "Application Status"
				Remarks
				Email
			)
		}
		default list All_Interviews
		{
			displayName = "All Interviews"
			show all rows from Interview    
			(
				Student
				Company
				Job_Role as "Job Role"
				Interview_Date as "Interview Date"
				Interview_Mode as "Interview Mode"
				Interview_Round as "Interview Round"
				Interview_Status as "Interview Status"
				Result
				Remarks
			)
		}
		list Student_Details_Report
		{
			displayName = "Student Details Report"
			show all rows from Student_Registration    
			(
				Student_Name  as "Student Name"
				Register_Number as "Register Number"
				Email
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Department as "Department "
				Year_field as "Year"
				CGPA
				Skills
				Certification
				Resume
				Placement_status as "Placement status"
				Preferred_Job_Role as "Preferred Job Role"
				Preferred_Location as "Preferred Location"
				Internship_Experience as "Internship Experience"
				Projects
				Number_of_Backlogs as "Number of Backlogs"
			)
		}
		list Company_Details_Report
		{
			displayName = "Company Details Report."
			show all rows from Company    
			(
				Company_Name as "Company Name"
				Company_Email as "Company Email"
				HR_Contact as "HR Contact"
				(
					displayformat = plainnumber 
				)
				Company_Location  as "Company Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Industry
				Website
			)
		}
		list Job_Application_Tracking_Report
		{
			displayName = "Job Application Tracking Report."
			show all rows from Job_Application    
			(
				Student 
				Student1 as "Student"
				Placement_Drive as "Placement Drive"
				Application_Date as "Application Date"
				Application_Status as "Application Status"
				Remarks
			)
		}
		list Interview_Tracking_Report
		{
			displayName = "Interview Tracking Report."
			show all rows from Interview    
			(
				Student
				Company
				Job_Role as "Job Role"
				Interview_Date as "Interview Date"
				Interview_Mode as "Interview Mode"
				Interview_Round as "Interview Round"
				Interview_Status as "Interview Status"
				Result
				Remarks
			)
			sort by
			(
				Interview_Date ascending
			)
		}
	}
	pages
	{
		page CampusHire_Dashboard
		{
			displayname = "CampusHire Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='51%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Student_Registration.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Registered Students'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='49%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Company.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Registered Companies.'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Placement_Drive.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Active Placement Drives.'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Interview.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Interviews Scheduled.'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='48%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Donut'\n\tytitle = 'Number of Students'\n\tbgColor = 'transparent'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'custom'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Student_Registration'\n\txfield = 'Placement_status'\n\tyfields = 'count:ID'\n\tquickFilters = 'Placement_status'\n/>\n\n</column><column\n   \t\t width='52%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Column'\n\txtitle = 'Application Status'\n\tytitle = 'Applications'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Job_Application'\n\txfield = 'Application_Status'\n\tyfields = 'count:Application_Status'\n/>\n\n</column>\n</row>\n</layout>\n</zml>"
		}
