		workflow
		{
		form
		{
			Job_Application_Submissio1 as "Job Application Submission Notification"
			{
				type =  form
				form = Job_Application

				record event = on add

				on user input of Application_Date
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"deepika.ss.2024.cse@rajalakshmi.edu.in"
											subject :"CampusHire - Job Application Confirmation"
											message :"Dear Student, Thank you for applying for a job through CampusHire! Your job application has been submitted successfully. Our placement team will review your application, and you can check your application status through the placement portal. Please keep checking your registered email for further updates regarding your application and interview schedule. We wish you all the best for your placement journey! Regards, CampusHire Placement Management Team."
										]
						)
					}
				}

			}
			Company_Registration_Noti as "Company Registration Notification"
			{
				type =  form
				form = Company

				record event = on add

				on user input of Company_Email
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Company_Email
											subject :"CampusHire - Company Registration Successful"
											message :"Dear Company Representative, Thank you for registering with CampusHire! Your company registration has been submitted successfully. You can now connect with students and manage placement opportunities. Regards, CampusHire Placement Management Team."
										]
						)
					}
				}

			}
			Interview_Scheduling_Noti1 as "Interview Scheduling Notification"
			{
				type =  form
				form = Interview

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"deepika.ss.2024.cse@rajalakshmi.edu.in"
											subject :"CampusHire - Interview Scheduled"
											message :"Dear Student, Your interview details have been recorded successfully in CampusHire. Please check the placement portal for your interview date and time. Best wishes for your interview! Regards, CampusHire Placement Management Team."
										]
						)
					}
				}

			}
			Placement_Drive_Notificat as "Placement Drive Notification"
			{
				type =  form
				form = Placement_Drive

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"deepika.ss.2024.cse@rajalakshmi.edu.in"
											subject :"CampusHire - New Placement Drive"
											message :"Dear Placement Administrator, A new placement drive has been registered successfully in CampusHire. Please log in to the placement portal to review the company details, eligibility criteria, job role, salary package, and important dates. Regards, CampusHire Placement Management Team."
										]
						)
					}
				}

			}
			Student_Registration_Conf as "Student Registration Confirmation"
			{
				type =  form
				form = Student_Registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"deepika.ss.2024.cse@rajalakshmi.edu.in"
											subject :"CampusHire - Student Registration Successful"
											message :"Dear Student, Congratulations! Your registration with CampusHire has been completed successfully. You can now explore placement drives, apply for eligible jobs, and track your applications through the placement portal. Best wishes for your placement journey! Regards, CampusHire Placement Management Team."
										]
						)
					}
				}

			}
			CRM as "CRM"
			{
				type =  form
				form = Student_Registration

				record event = on add or edit

				on success
				{
					actions 
					{
							ZohoCRM.v2.createLead(data:{"Company":"Projects","Email":"Email","Last_Name":"Student_Name.last_name","Phone":"Phone_Number1"});
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

